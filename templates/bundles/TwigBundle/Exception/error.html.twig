{% extends 'base.html.twig' %}

{% block title %}{{ status_code }} · Crieur{% endblock %}

{% block body %}
    <section class="confirm" aria-labelledby="error-title">
        <p class="state-line status--failed">{{ icon('alert') }}<span>{{ 'error.code'|trans({'%code%': status_code}) }}</span></p>
        <h1 class="confirm__title" id="error-title">{{ (status_code == 404 ? 'error.not_found' : (status_code == 403 ? 'error.forbidden' : 'error.generic'))|trans }}</h1>
        <div class="confirm__actions">
            <a class="button button--primary" href="{{ path('home') }}">{{ icon('arrow-left') }}<span>{{ 'reader.back'|trans }}</span></a>
        </div>
    </section>
{% endblock %}
