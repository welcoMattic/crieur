{%- set rewritten = segment.spoken != segment.text -%}
<span class="seg{{ segment.removed ? ' is-removed' }}" data-position="{{ segment.position }}" data-spoken-hash="{{ segment.spoken|spoken_hash }}"{% if rewritten %} data-rewritten{% endif %}{% if segment.removed %} title="{{ 'reader.removed'|trans }}"{% endif %}><span class="seg__text">{{ segment.text }}</span><span class="seg__spoken"{% if segment.spoken|trim is empty or segment.removed %} data-skipped="{{ 'reader.skipped'|trans }}"{% endif %}>{{ segment.spoken|trim is empty or segment.removed ? '' : segment.spoken }}</span></span>{{ ' ' }}
