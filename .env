# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/ai-mistral-platform ###
# Cloud stack: Voxtral voices and the Mistral speech editor. Leave empty to stay local.
MISTRAL_API_KEY=
###< symfony/ai-mistral-platform ###

###> crieur ###
# Local stack: Ollama 0.40.11+ serves Phonon voices (Apple Silicon) and the local speech editor.
OLLAMA_HOST_URL=http://127.0.0.1:11434
# Docker Model Runner, for the local speech editor: docker model pull ai/ministral3:8B-Q4_K_M
DOCKER_MODEL_RUNNER_URL=http://127.0.0.1:12434
# Hosts without Ollama for Phonon (it runs Phonon on Apple Silicon only): the Phonon servers of
# Gradium (ghcr.io/gradium-ai/ptts-openai-server), one per language. Empty: Phonon through Ollama.
# CRIEUR_PHONON_SERVERS=fr=http://127.0.0.1:8880,en=http://127.0.0.1:8881
CRIEUR_PHONON_SERVERS=
# The article extractor (Defuddle), built by tools/defuddle/build.sh (Bun 1.3.2).
CRIEUR_DEFUDDLE="%kernel.project_dir%/tools/defuddle/build/defuddle"
# The Phonon model as Ollama names it (what the pages show with the Phonon servers).
CRIEUR_PHONON_MODEL=phonon:40m-multilingual
# Voice engine: "phonon" (local: Ollama, or the Phonon servers above) or "voxtral" (Mistral cloud).
CRIEUR_VOICE_ENGINE=phonon
# Speech editor (LLM that rewrites the text for the ear): "auto", "dmr" (Ministral 3 in Docker Model
# Runner), "mistral" (Mistral Small) or "off". "auto" uses Mistral when MISTRAL_API_KEY is set, else
# the deterministic rules only.
CRIEUR_EDITOR=auto
# Fetching pages on private networks (localhost, 10.0.0.0/8...) is refused unless enabled.
CRIEUR_ALLOW_PRIVATE_NETWORKS=0
# Token the browser extension sends (Authorization: Bearer ...). It guards /api only (the extension);
# empty, anyone who reaches the server can add articles through it. The web pages have no login:
# whoever reaches them can add, change and delete articles, so keep Crieur on a trusted network.
CRIEUR_API_TOKEN=
# Host names the MCP server answers for over HTTP (/mcp), comma-separated: add the public name of
# your Crieur to reach it from another machine.
CRIEUR_MCP_HOSTS=localhost,127.0.0.1,[::1]
# Public demo only (APP_ENV=demo): HTML added at the end of <head>, an analytics script for instance.
CRIEUR_DEMO_HEAD=
# Where the synthesized audio is stored.
CRIEUR_AUDIO_DIR="%kernel.project_dir%/var/audio"
###< crieur ###
