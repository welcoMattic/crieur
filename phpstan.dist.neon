parameters:
    level: 8
    paths:
        - src
        - tests
    parallel:
        # Small jobs keep each worker under the 128 MB memory_limit of the CLI on a cold cache.
        jobSize: 4
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
