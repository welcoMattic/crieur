# Settings of Crieur in Docker Compose. Copy this file to .env.docker, then fill in what you use.

# Linux and Windows (compose.gradium.yaml): a Hugging Face token (read access) of an account that
# accepted the terms of https://huggingface.co/gradium/phonon-40m-fr and
# https://huggingface.co/gradium/phonon-40m-en.
HF_TOKEN=

# Optional: Voxtral voices and the Mistral Small editor, in the cloud of Mistral AI.
MISTRAL_API_KEY=
# CRIEUR_VOICE_ENGINE=voxtral
# CRIEUR_EDITOR=mistral

# Linux with Docker Engine (no Docker Desktop): the address of Docker Model Runner.
# DOCKER_MODEL_RUNNER_URL=http://172.17.0.1:12434

# Optional: the token of the browser extension.
# CRIEUR_API_TOKEN=
